---
import BaseLayout from "../layouts/BaseLayout.astro";
import data from "../data.json";
import { projects } from "../data/projects";

const { profile, interests, experience, skills, education, portfolio, details } =
  data;

const escapeHtml = (value) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");

const highlightExperienceText = (value) => {
  const technologyTerms = [
    "CI/CD",
    "OTA",
    "Maestro",
    "EAS Workflows",
    "GitHub Actions",
    "Hermes",
    "Azure Container Apps",
    "React Native",
    "Next.js",
    "Node.js",
    "SQL",
    "Expo Router",
    "Statsig",
    "Mixpanel",
    "OCR",
    "AGENTS.md",
    "SKILLS.md",
  ];

  const normalized = value.replaceAll("&#39;", "'").replaceAll("&apos;", "'");
  const escaped = escapeHtml(normalized);
  const sortedTerms = [...technologyTerms].sort((a, b) => b.length - a.length);
  const termsPattern = sortedTerms
    .map((term) => term.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"))
    .join("|");

  // The trailing lookahead keeps the unit inside the bold ("20%", "100 MB")
  // while still refusing partial matches like the "3" in "3D".
  const withNumbersHighlighted = escaped.replace(
    /\b\d+(?:\.\d+)?(?:\s?(?:%|MB|GB|K|k|x|X))?(?![A-Za-z0-9])/g,
    (match) => `<strong>${match}</strong>`,
  );

  if (!termsPattern) {
    return withNumbersHighlighted;
  }

  return withNumbersHighlighted.replace(
    new RegExp(`\\b(${termsPattern})\\b`, "g"),
    (match) => `<strong>${match}</strong>`,
  );
};
---

<BaseLayout>
  <div
    class="max-w-[1100px] w-full mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 py-12"
  >
    <!-- Row 1 -->
    <!-- Profile / Hero Card -->
    <section
      aria-labelledby="profile-heading"
      class="md:col-span-2 lg:col-span-3 bg-white rounded-3xl p-8 shadow-sm border border-gray-200 flex flex-col justify-center transform transition duration-300 hover:-translate-y-1 hover:shadow-lg"
    >
      <div class="flex flex-col sm:flex-row gap-6 items-center sm:items-start">
        <img
          src={profile.image[0].black}
          alt={profile.name}
          width="112"
          height="112"
          fetchpriority="high"
          class="w-28 h-28 rounded-full bg-gray-100 object-cover shadow-inner shrink-0"
        />
        <div class="text-center sm:text-left">
          <h1
            id="profile-heading"
            class="section-title text-4xl lg:text-5xl font-extrabold tracking-tight mb-4 text-gray-900"
          >
            {profile.name}
          </h1>
          <p class="text-gray-600 leading-relaxed text-lg mb-6">
            {profile.bio}
          </p>
          <div class="flex flex-wrap gap-3 justify-center sm:justify-start">
          <a
            href="https://drive.google.com/file/d/1QbYRIPiXyfFjMNGtq68Rqa6Be8jo6x8K/view?usp=sharing"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-black text-white px-8 py-3 rounded-full font-semibold hover:bg-gray-800 transition shadow-md hover:-translate-y-0.5"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
              ></path>
            </svg>
            Download CV
          </a>
          <a
            href="/blog"
            class="inline-flex items-center justify-center gap-2 bg-white text-gray-900 border border-gray-200 px-8 py-3 rounded-full font-semibold hover:bg-gray-100 transition shadow-sm hover:-translate-y-0.5"
          >
            Read the Blog
          </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Row 2 -->
    <!-- Left column: Contact, Connect, Interests, Education (natural heights, no stretch) -->
    <div
      class="md:col-span-2 lg:col-span-3 grid grid-cols-1 lg:grid-cols-3 gap-6 items-start"
    >
      <div class="lg:col-span-1 flex flex-col gap-6">
        <!-- Contact Card -->
        <section
          aria-labelledby="contact-heading"
          class="bg-white rounded-3xl p-6 shadow-sm border border-gray-200 flex flex-col gap-4 transform transition duration-300 hover:-translate-y-1 hover:shadow-lg"
        >
          <h2 id="contact-heading" class="sr-only">Contact</h2>
          {
            details.map((detail) => (
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center shrink-0 border border-gray-100">
                  {detail.icon ? (
                    <img
                      src={detail.icon}
                      alt={detail.type}
                      width="20"
                      height="20"
                      class="w-5 h-5 opacity-70 object-contain"
                    />
                  ) : (
                    <div class="w-5 h-5 text-gray-400 font-bold flex items-center justify-center">
                      ·
                    </div>
                  )}
                </div>
                <div class="overflow-hidden">
                  <div class="detail-label text-[11px] text-gray-500 uppercase tracking-widest font-bold mb-0.5">
                    {detail.type}
                  </div>
                  {detail.url && detail.url !== "#" ? (
                    <a
                      href={detail.url}
                      class="detail-value font-semibold text-gray-900 hover:text-blue-600 transition block [overflow-wrap:break-word]"
                      set:html={escapeHtml(detail.value).replace("@", "@<wbr>")}
                    />
                  ) : (
                    <div class="detail-value font-semibold text-gray-900 block [overflow-wrap:break-word]">
                      {detail.value}
                    </div>
                  )}
                </div>
              </div>
            ))
          }
        </section>

        <!-- Connect Card -->
        <section
          aria-labelledby="connect-heading"
          class="bg-white rounded-3xl p-6 shadow-sm border border-gray-200 transform transition duration-300 hover:-translate-y-1 hover:shadow-lg"
        >
          <h2 id="connect-heading" class="card-title text-lg font-bold mb-5 text-gray-900">
            Connect
          </h2>
          {
            portfolio.length >= 6 ? (
              <div class="flex flex-wrap gap-3">
                {portfolio.map((social) => (
                  <a
                    href={social.url}
                    title={social.name}
                    class="w-12 h-12 flex items-center justify-center bg-gray-50 border border-gray-100 rounded-2xl hover:bg-gray-100 hover:scale-105 transition-transform shadow-sm"
                  >
                    <img
                      src={social.icon}
                      alt={social.name}
                      width="24"
                      height="24"
                      class="w-6 h-6 object-contain"
                    />
                  </a>
                ))}
              </div>
            ) : (
              <>
                <div class="flex md:hidden flex-wrap gap-3">
                  {portfolio.map((social) => (
                    <a
                      href={social.url}
                      title={social.name}
                      class="w-12 h-12 flex items-center justify-center bg-gray-50 border border-gray-100 rounded-2xl hover:bg-gray-100 hover:scale-105 transition-transform shadow-sm"
                    >
                      <img
                        src={social.icon}
                        alt={social.name}
                        width="24"
                      height="24"
                      class="w-6 h-6 object-contain"
                      />
                    </a>
                  ))}
                </div>
                <div class="hidden md:flex flex-col gap-3">
                  {portfolio.map((social) => (
                    <a
                      href={social.url}
                      title={social.name}
                      class="flex items-center gap-4 px-5 py-3.5 bg-gray-50 border border-gray-100 rounded-2xl hover:bg-gray-100 hover:-translate-y-0.5 transition-transform shadow-sm"
                    >
                      <img
                        src={social.icon}
                        alt={social.name}
                        width="24"
                      height="24"
                      class="w-6 h-6 object-contain"
                      />
                      <span class="font-semibold text-gray-700">
                        {social.name}
                      </span>
                    </a>
                  ))}
                </div>
              </>
            )
          }
        </section>

        <!-- Interests Card -->
        <section
          aria-labelledby="interests-heading"
          class="bg-white rounded-3xl p-6 shadow-sm border border-gray-200 transform transition duration-300 hover:-translate-y-1 hover:shadow-lg"
        >
          <h2 id="interests-heading" class="card-title text-lg font-bold mb-5 text-gray-900">
            Interests
          </h2>
          <div class="flex flex-wrap gap-2.5">
            {
              interests.map((interest) => (
                <span class="px-4 py-2 bg-gray-50 border border-gray-100 text-gray-700 rounded-xl text-sm font-semibold">
                  {interest.name}
                </span>
              ))
            }
          </div>
        </section>

        <!-- Education Card -->
        <section
          aria-labelledby="education-heading"
          class="bg-white rounded-3xl p-6 shadow-sm border border-gray-200 transform transition duration-300 hover:-translate-y-1 hover:shadow-lg"
        >
          <h2 id="education-heading" class="card-title text-xl font-bold mb-6 text-gray-900">
            Education
          </h2>
          <div class="space-y-6">
            {
              education.map((edu) => (
                <div class="relative pl-5 before:content-[''] before:absolute before:left-0 before:top-2 before:w-2 before:h-2 before:border-2 before:border-gray-300 before:rounded-full">
                  <h3 class="font-bold text-sm text-gray-900">{edu.level}</h3>
                  <div class="text-gray-600 text-sm mt-1">{edu.details}</div>
                  <div class="text-gray-500 text-xs font-medium mt-1">
                    {edu.institution} • {edu.year}
                  </div>
                </div>
              ))
            }
          </div>
        </section>
      </div>

      <!-- Right column: Experience + Tech Stack -->
      <div class="lg:col-span-2 flex flex-col gap-6">
      <!-- Experience Card -->
      <section
        aria-labelledby="experience-heading"
        class="bg-white rounded-3xl p-8 shadow-sm border border-gray-200 transform transition duration-300 hover:-translate-y-1 hover:shadow-lg"
      >
        <h2 id="experience-heading" class="section-title text-2xl font-bold mb-8 text-gray-900">
          Experience
        </h2>
        <div class="space-y-8">
          {
            experience.map((exp) => {
              const visiblePoints = exp.points.slice(0, 4);
              const hiddenPoints = exp.points.slice(4);
              return (
                <div class="relative pl-6 before:content-[''] before:absolute before:left-0 before:top-2 before:w-2 before:h-2 before:bg-blue-500 before:rounded-full after:content-[''] after:absolute after:left-[3px] after:top-4 after:w-0.5 after:h-full after:bg-gray-100 last:after:hidden">
                  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-3 gap-2">
                    <div>
                      <h3 class="card-title font-bold text-xl text-gray-900">
                        {exp.role}
                      </h3>
                      <div class="text-gray-500 font-semibold mt-1">
                        {exp.company}
                      </div>
                    </div>
                    <span class="text-xs font-bold text-gray-500 bg-gray-100 px-3 py-1.5 rounded-full shrink-0">
                      {exp.period}
                    </span>
                  </div>
                  <ul class="list-none text-gray-600 text-sm space-y-2 mt-4">
                    {visiblePoints.map((point) => (
                      <li
                        class="relative pl-4 before:content-[''] before:absolute before:left-0 before:top-2 before:w-1.5 before:h-1.5 before:bg-gray-300 before:rounded-full"
                        set:html={highlightExperienceText(point)}
                      />
                    ))}
                  </ul>
                  {hiddenPoints.length > 0 && (
                    <>
                      {/* Extra points expand in place under the visible ones;
                          the toggle sits below them and flips to "Show less". */}
                      <ul
                        id={`exp-more-${exp.id}`}
                        class="list-none text-gray-600 text-sm space-y-2 mt-2"
                        hidden
                      >
                        {hiddenPoints.map((point) => (
                          <li
                            class="relative pl-4 before:content-[''] before:absolute before:left-0 before:top-2 before:w-1.5 before:h-1.5 before:bg-gray-300 before:rounded-full"
                            set:html={highlightExperienceText(point)}
                          />
                        ))}
                      </ul>
                      <button
                        type="button"
                        class="exp-toggle group/toggle mt-3 inline-flex items-center gap-1 text-xs font-semibold text-gray-500 hover:text-blue-600 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 rounded"
                        aria-expanded="false"
                        aria-controls={`exp-more-${exp.id}`}
                      >
                        <span class="exp-toggle-label">Show more</span>
                        <svg
                          class="w-3.5 h-3.5 transition-transform group-aria-expanded/toggle:rotate-180"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="m6 9 6 6 6-6" />
                        </svg>
                      </button>
                    </>
                  )}
                </div>
              );
            })
          }
        </div>
      </section>

      <!-- Skills Card -->
      <section
        aria-labelledby="skills-heading"
        class="bg-white rounded-3xl p-8 shadow-sm border border-gray-200 flex flex-col justify-center transform transition duration-300 hover:-translate-y-1 hover:shadow-lg"
      >
      <h2 id="skills-heading" class="section-title text-2xl font-bold mb-6 text-gray-900">Tech Stack</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 w-full">
        <div class="min-w-0 flex flex-col sm:items-start">
          <h3
            class="text-[11px] font-bold text-gray-500 uppercase tracking-widest mb-4 truncate w-full text-left"
            title="Languages & Frameworks"
          >
            Languages & Frameworks
          </h3>
          <div class="flex flex-wrap gap-3 justify-start">
            {
              skills.languages_frameworks.map((skill) => (
                <div
                  class="w-10 h-10 bg-gray-50 border border-gray-100 rounded-xl flex items-center justify-center shadow-sm p-2"
                  title={skill.name}
                >
                  <img
                    src={skill.icon}
                    alt={skill.name}
                    loading="lazy"
                    decoding="async"
                    width="40"
                    height="40"
                    class="w-full h-full object-contain"
                  />
                </div>
              ))
            }
          </div>
        </div>
        <div class="min-w-0 flex flex-col sm:items-center">
          <h3
            class="text-[11px] font-bold text-gray-500 uppercase tracking-widest mb-4 truncate w-full text-left sm:text-center"
            title="Backend & DB"
          >
            Backend & DB
          </h3>
          <div class="flex flex-wrap gap-3 justify-start sm:justify-center">
            {
              skills.backend_databases.map((skill) => (
                <div
                  class="w-10 h-10 bg-gray-50 border border-gray-100 rounded-xl flex items-center justify-center shadow-sm p-2"
                  title={skill.name}
                >
                  <img
                    src={skill.icon}
                    alt={skill.name}
                    loading="lazy"
                    decoding="async"
                    width="40"
                    height="40"
                    class="w-full h-full object-contain"
                  />
                </div>
              ))
            }
          </div>
        </div>
        <div class="min-w-0 flex flex-col sm:items-end">
          <h3
            class="text-[11px] font-bold text-gray-500 uppercase tracking-widest mb-4 truncate w-full text-left sm:text-right"
            title="Tools & Platforms"
          >
            Tools & Platforms
          </h3>
          <div class="flex flex-wrap gap-3 justify-start sm:justify-end">
            {
              skills.tools_platforms.map((skill) => (
                <div
                  class="w-10 h-10 bg-gray-50 border border-gray-100 rounded-xl flex items-center justify-center shadow-sm p-2"
                  title={skill.name}
                >
                  <img
                    src={skill.icon}
                    alt={skill.name}
                    loading="lazy"
                    decoding="async"
                    width="40"
                    height="40"
                    class="w-full h-full object-contain"
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>
      </section>
      </div>
    </div>

    <!-- Row 4 -->
    <!-- Projects Card -->
    {
      projects.length > 0 && (
        <section
          id="projects"
          aria-labelledby="projects-heading"
          class="md:col-span-2 lg:col-span-3 bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-gray-200 scroll-mt-6 transform transition duration-300 hover:-translate-y-1 hover:shadow-lg"
        >
          <h2 id="projects-heading" class="section-title text-2xl font-bold mb-8 text-gray-900">
            Featured Projects
          </h2>
          <div
            class:list={[
              "grid grid-cols-1 gap-6 lg:gap-8",
              projects.length > 1 && "md:grid-cols-2",
              projects.length > 2 && "lg:grid-cols-3",
            ]}
          >
            {projects.map((project) => {
              // A lone project gets a wide, side-by-side layout instead of a
              // narrow card stranded in one column of an empty grid.
              const wide = projects.length === 1;
              const primaryUrl = project.liveUrl ?? project.repoUrl;
              const links = [
                project.liveUrl && { label: "Live Demo", href: project.liveUrl, icon: "live", external: true, kind: "secondary" },
                project.repoUrl && { label: "View Code", href: project.repoUrl, icon: "github", external: true, kind: "secondary" },
                project.backendRepoUrl && { label: "Backend Code", href: project.backendRepoUrl, icon: "server", external: true, kind: "secondary" },
                // Privacy policy page stays live (app stores link to it) but is hidden from the card.
              ].filter(Boolean);
              // The first button is the primary call to action.
              if (links[0] && links[0].kind !== "text") links[0].kind = "primary";
              return (
                <article
                  class:list={[
                    "group bg-gray-50 rounded-2xl overflow-hidden border border-gray-100 transition hover:shadow-md flex flex-col",
                    wide && "lg:flex-row",
                  ]}
                >
                  <a
                    href={primaryUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    tabindex="-1"
                    aria-hidden="true"
                    class:list={[
                      "block bg-gray-200 overflow-hidden relative shrink-0 aspect-[5/3] md:aspect-[5/2]",
                      wide && "lg:aspect-auto lg:w-2/5 lg:min-h-[260px]",
                    ]}
                  >
                    <img
                      src={project.image}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      width="640"
                      height="384"
                      class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    />
                  </a>
                  <div
                    class:list={[
                      "p-6 bg-white border-t border-gray-100 flex-1 flex flex-col",
                      wide && "lg:border-t-0 lg:border-l lg:p-8",
                    ]}
                  >
                    <h3 class="card-title font-bold text-xl mb-2 text-gray-900">
                      {primaryUrl ? (
                        <a
                          href={primaryUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="hover:text-blue-600 transition"
                        >
                          {project.title}
                        </a>
                      ) : (
                        project.title
                      )}
                    </h3>
                    <p class="text-gray-600 text-sm sm:text-base leading-relaxed mb-5">
                      {project.description}
                    </p>
                    {project.tags.length > 0 && (
                      <ul class="flex flex-wrap gap-2 mb-6" aria-label={`${project.title} tech stack`}>
                        {project.tags.map((tag) => (
                          <li class="px-2.5 py-1 bg-gray-100 text-gray-600 rounded-lg text-xs font-semibold">
                            {tag}
                          </li>
                        ))}
                      </ul>
                    )}
                    {links.length > 0 && (
                      <div class="mt-auto flex flex-wrap items-center gap-3 text-sm font-semibold">
                        {links.map((link) => (
                          <a
                            href={link.href}
                            {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                            aria-label={link.external ? `${project.title} ${link.label} (opens in a new tab)` : `${project.title} ${link.label}`}
                            class:list={[
                              "group/link inline-flex items-center gap-2 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500",
                              link.kind === "primary" &&
                                "bg-black text-white px-5 py-2.5 rounded-full shadow-md hover:bg-gray-800 hover:-translate-y-0.5",
                              link.kind === "secondary" &&
                                "bg-white text-gray-900 border border-gray-200 px-5 py-2.5 rounded-full shadow-sm hover:bg-gray-100 hover:-translate-y-0.5",
                              link.kind === "text" &&
                                "text-gray-500 px-1 py-2.5 rounded underline underline-offset-4 decoration-gray-300 hover:text-blue-600 hover:decoration-blue-400",
                            ]}
                          >
                            {link.icon === "github" && (
                              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
                            )}
                            {link.icon === "server" && (
                              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="8" rx="2"/><rect x="2" y="13" width="20" height="8" rx="2"/><path d="M6 7h.01M6 17h.01"/></svg>
                            )}
                            {link.icon === "shield" && (
                              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
                            )}
                            {link.icon === "live" && (
                              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6M10 14 21 3"/></svg>
                            )}
                            {link.label}
                            {link.external && (
                              <svg class="w-3.5 h-3.5 opacity-70 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
                            )}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  // Experience "Show more" / "Show less" toggles.
  document.querySelectorAll<HTMLButtonElement>(".exp-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const list = document.getElementById(btn.getAttribute("aria-controls") ?? "");
      if (!list) return;
      const expanded = btn.getAttribute("aria-expanded") === "true";
      list.hidden = expanded;
      btn.setAttribute("aria-expanded", String(!expanded));
      const label = btn.querySelector(".exp-toggle-label");
      if (label) label.textContent = expanded ? "Show more" : "Show less";
      // After collapsing a long list, keep the button on screen.
      if (expanded) {
        const { top } = btn.getBoundingClientRect();
        if (top < 0) btn.scrollIntoView({ block: "center" });
      }
    });
  });
</script>
