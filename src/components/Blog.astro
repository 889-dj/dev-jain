---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
).slice(0, 3);
---

<section id="blog">
  <div class="container">
    <h2 class="section-title fade-in">Blog</h2>

    <div class="posts-grid">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="post-card fade-in">
          <time class="post-date">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          <h3 class="post-title">{post.data.title}</h3>
          <p class="post-excerpt">{post.data.description}</p>
          <span class="read-more">Read more →</span>
        </a>
      ))}
    </div>

    {posts.length > 0 && (
      <div class="view-all fade-in">
        <a href="/blog" class="btn btn-outline">View all posts</a>
      </div>
    )}
  </div>
</section>

<style>
  .posts-grid {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .post-card {
    display: block;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: all var(--transition);
    color: inherit;
  }

  .post-card:hover {
    border-color: var(--accent);
    box-shadow: var(--card-shadow);
    transform: translateY(-2px);
    color: inherit;
  }

  .post-date {
    font-size: 0.8rem;
    color: var(--text-secondary);
    display: block;
    margin-bottom: 0.5rem;
  }

  .post-title {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .post-excerpt {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .read-more {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
  }

  .view-all {
    text-align: center;
  }
</style>
