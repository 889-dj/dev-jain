---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const localPosts = await getCollection("blog");
  const devtoPosts = await getCollection("devto");

  // Local markdown always wins a slug clash with a cross-posted article.
  const localIds = new Set(localPosts.map((post) => post.id));

  const paths = localPosts.map((post) => ({
    params: { slug: post.id },
    props: { post, devtoUrl: undefined as string | undefined },
  }));

  for (const post of devtoPosts) {
    if (localIds.has(post.id)) {
      console.warn(
        `[blog] dev.to article "${post.id}" collides with a local post; keeping the local one.`,
      );
      continue;
    }
    paths.push({
      params: { slug: post.id },
      props: { post, devtoUrl: post.data.devtoUrl },
    });
  }

  return paths;
}

const { post, devtoUrl } = Astro.props as {
  post: CollectionEntry<"blog"> | CollectionEntry<"devto">;
  devtoUrl?: string;
};
const renderedHtml = post.rendered?.html ?? "";
const canonicalPath = `/blog/${post.id}`;
const publishedTime = post.data.date.toISOString();
const modifiedTime = (post.data.updatedDate ?? post.data.date).toISOString();
const coverImage = "coverImage" in post.data ? post.data.coverImage : undefined;

// Cross-posted articles point search engines back at the dev.to original.
const canonicalUrl = devtoUrl ?? `https://devjain.in${canonicalPath}`;

const blogPostingSchema = {
  "@type": "BlogPosting",
  "@id": `${canonicalUrl}#blogposting`,
  mainEntityOfPage: canonicalUrl,
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishedTime,
  dateModified: modifiedTime,
  author: {
    "@type": "Person",
    name: "Dev Jain",
    url: "https://devjain.in/",
  },
  publisher: {
    "@type": "Person",
    name: "Dev Jain",
  },
  keywords: post.data.tags?.join(", "),
  inLanguage: "en-US",
};
---

<BaseLayout
  title={`${post.data.title} - Dev Jain`}
  description={post.data.description}
  type="article"
  canonicalUrl={canonicalUrl}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  keywords={post.data.tags?.length
    ? post.data.tags
    : ["web development", "software engineering"]}
  schema={blogPostingSchema}
>
  <div class="post-page">
    <article class="container">
      <a href="/blog" class="back-link">← Back to blog</a>
      <header class="post-header">
        <time class="post-date"
          >{
            post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }</time
        >
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
        {
          devtoUrl && (
            <p class="post-origin">
              Originally published on{" "}
              <a href={devtoUrl} target="_blank" rel="noopener noreferrer">
                dev.to
              </a>
            </p>
          )
        }
      </header>
      {
        coverImage && (
          <img
            src={coverImage}
            alt={post.data.title}
            width="1000"
            height="420"
            class="post-cover"
          />
        )
      }
      <div class="post-content" set:html={renderedHtml} />
    </article>
  </div>
</BaseLayout>

<style>
  .post-page {
    padding-top: 3rem;
    min-height: 100vh;
  }

  .back-link {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-header {
    max-width: 700px;
    margin-bottom: 3rem;
  }

  .post-date {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .post-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -1px;
    margin: 0.5rem 0;
    line-height: 1.2;
  }

  .post-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .post-content {
    max-width: 700px;
    line-height: 1.8;
  }

  .post-content h1,
  .post-content h2,
  .post-content h3 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-weight: 700;
  }

  .post-content h1 {
    font-size: 1.75rem;
  }
  .post-content h2 {
    font-size: 1.5rem;
  }
  .post-content h3 {
    font-size: 1.25rem;
  }

  .post-content p {
    margin-bottom: 1.25rem;
    color: var(--text-secondary);
  }

  .post-content ul,
  .post-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: var(--text-secondary);
  }

  .post-content li {
    margin-bottom: 0.4rem;
  }

  .post-content blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .post-content pre {
    background: var(--code-bg);
    padding: 1rem;
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
  }

  .post-content code {
    font-family: "SF Mono", "Fira Code", "Fira Mono", Menlo, monospace;
    font-size: 0.9em;
  }

  .post-content :not(pre) > code {
    background: var(--code-bg);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  .post-origin {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .post-origin a {
    color: var(--accent);
  }

  .post-cover {
    width: 100%;
    max-width: 700px;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin-bottom: 2rem;
  }

  /* dev.to bodies carry full-width images, tables and embeds */
  .post-content img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .post-content a {
    color: var(--accent);
  }

  .post-content table {
    width: 100%;
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
  }

  .post-content th,
  .post-content td {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .post-content iframe {
    max-width: 100%;
  }
</style>
