---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .filter((post) => !post.data.draft);

const blogSchema = {
  "@type": "Blog",
  "@id": "https://yourdomain.com/blog/#blog",
  url: "https://yourdomain.com/blog",
  name: "Your Name Blog",
  description:
    "Articles about software engineering, frontend architecture, and performance.",
  inLanguage: "en-US",
};

const blogCollectionSchema = {
  "@type": "CollectionPage",
  "@id": "https://yourdomain.com/blog/#collection",
  url: "https://yourdomain.com/blog",
  name: "Blog - Your Name",
  hasPart: allPosts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    url: `https://yourdomain.com/blog/${post.id}`,
    datePublished: post.data.date.toISOString(),
    description: post.data.description,
  })),
};
---

<BaseLayout
  title="Blog - Your Name"
  description="Technical writing on web development, architecture, and developer tooling."
  canonicalPath="/blog"
  keywords={[
    "developer blog",
    "web development articles",
    "astro blog",
    "frontend architecture",
  ]}
  schema={[blogSchema, blogCollectionSchema]}
>
  <Header />
  <main class="blog-page">
    <div class="container">
      <h1 class="page-title">Blog</h1>
      <p class="page-subtitle">
        Thoughts on development, design, and building for the web.
      </p>

      <div class="posts-list">
        {
          allPosts.map((post) => (
            <a href={`/blog/${post.id}`} class="post-item fade-in">
              <div class="post-meta">
                <time>
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
              </div>
              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-desc">{post.data.description}</p>
            </a>
          ))
        }
      </div>

      {
        allPosts.length === 0 && (
          <p class="no-posts">No posts yet. Check back soon!</p>
        )
      }
    </div>
  </main>
</BaseLayout>

<style>
  .blog-page {
    padding-top: calc(var(--nav-height) + 3rem);
    min-height: 100vh;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-bottom: 3rem;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 700px;
  }

  .post-item {
    display: block;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card-bg);
    transition: all var(--transition);
    color: inherit;
  }

  .post-item:hover {
    border-color: var(--accent);
    box-shadow: var(--card-shadow);
    transform: translateX(4px);
    color: inherit;
  }

  .post-meta time {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .post-title {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0.4rem 0;
  }

  .post-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .no-posts {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }
</style>

<script is:inline>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 },
  );
  document.querySelectorAll(".fade-in").forEach((el) => observer.observe(el));
</script>
