---
interface Role {
  company: string;
  role: string;
  period: string;
  description: string;
  tech: string[];
}

const roles: Role[] = [
  {
    company: 'TechCorp Inc.',
    role: 'Senior Frontend Engineer',
    period: '2023 — Present',
    description: 'Leading the frontend architecture for a SaaS platform serving 50k+ users. Migrated legacy codebase to React + TypeScript, improving performance by 40%.',
    tech: ['React', 'TypeScript', 'GraphQL', 'Vitest'],
  },
  {
    company: 'StartupXYZ',
    role: 'Full-Stack Developer',
    period: '2021 — 2023',
    description: 'Built and maintained multiple microservices and their corresponding frontends. Shipped features end-to-end from database design to pixel-perfect UI.',
    tech: ['Next.js', 'Node.js', 'PostgreSQL', 'Docker'],
  },
  {
    company: 'Digital Agency Co.',
    role: 'Junior Developer',
    period: '2019 — 2021',
    description: 'Developed responsive websites and web applications for clients across various industries. Learned the fundamentals of clean, maintainable code.',
    tech: ['JavaScript', 'PHP', 'WordPress', 'SCSS'],
  },
];
---

<section id="experience">
  <div class="container">
    <h2 class="section-title fade-in">Experience</h2>

    <div class="timeline">
      {roles.map((role, i) => (
        <div class="timeline-item fade-in">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <div>
                <h3 class="timeline-role">{role.role}</h3>
                <p class="timeline-company">{role.company}</p>
              </div>
              <span class="timeline-period">{role.period}</span>
            </div>
            <p class="timeline-desc">{role.description}</p>
            <div class="timeline-tech">
              {role.tech.map((t) => (
                <span class="tech-tag">{t}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--timeline-line);
  }

  .timeline-item {
    position: relative;
    padding-bottom: 2.5rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -2rem;
    top: 6px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--timeline-dot);
    border: 3px solid var(--bg);
    z-index: 1;
  }

  .timeline-content {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: all var(--transition);
  }

  .timeline-content:hover {
    box-shadow: var(--card-shadow);
    border-color: var(--accent);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .timeline-role {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .timeline-company {
    color: var(--accent);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .timeline-period {
    font-size: 0.85rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .timeline-desc {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .timeline-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    background: var(--tag-bg);
    color: var(--tag-text);
    border-radius: 999px;
  }
</style>
