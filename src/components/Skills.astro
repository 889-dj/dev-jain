---
interface Skill {
  name: string;
  level: 'expert' | 'advanced' | 'intermediate';
}

interface Category {
  label: string;
  skills: Skill[];
}

const categories: Category[] = [
  {
    label: 'Frontend',
    skills: [
      { name: 'TypeScript', level: 'expert' },
      { name: 'React', level: 'expert' },
      { name: 'Astro', level: 'advanced' },
      { name: 'Next.js', level: 'advanced' },
      { name: 'CSS / Tailwind', level: 'expert' },
      { name: 'HTML / Accessibility', level: 'expert' },
    ],
  },
  {
    label: 'Backend',
    skills: [
      { name: 'Node.js', level: 'expert' },
      { name: 'Python', level: 'advanced' },
      { name: 'PostgreSQL', level: 'advanced' },
      { name: 'REST / GraphQL', level: 'advanced' },
      { name: 'Docker', level: 'intermediate' },
    ],
  },
  {
    label: 'Tools & More',
    skills: [
      { name: 'Git', level: 'expert' },
      { name: 'CI/CD', level: 'advanced' },
      { name: 'Testing (Vitest, Playwright)', level: 'advanced' },
      { name: 'AWS / Vercel', level: 'intermediate' },
      { name: 'Figma', level: 'intermediate' },
    ],
  },
];

const levelColors = {
  expert: '#22c55e',
  advanced: '#3b82f6',
  intermediate: '#f59e0b',
};
---

<section id="skills">
  <div class="container">
    <h2 class="section-title fade-in">Skills</h2>

    <div class="filter-bar fade-in">
      <button class="filter-btn active" data-filter="all">All</button>
      {categories.map((cat) => (
        <button class="filter-btn" data-filter={cat.label}>{cat.label}</button>
      ))}
    </div>

    <div class="skills-grid" id="skillsGrid">
      {categories.map((cat) =>
        cat.skills.map((skill) => (
          <div class="skill-card fade-in" data-category={cat.label}>
            <div class="skill-header">
              <span class="skill-name">{skill.name}</span>
              <span class="skill-level" style={`background: ${levelColors[skill.level]}`}>{skill.level}</span>
            </div>
            <div class="skill-bar">
              <div class="skill-fill" style={`width: ${skill.level === 'expert' ? '95' : skill.level === 'advanced' ? '75' : '55'}%`}></div>
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</section>

<style>
  .filter-bar {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 0.4rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition);
  }

  .filter-btn:hover,
  .filter-btn.active {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .skill-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    transition: all var(--transition);
  }

  .skill-card:hover {
    border-color: var(--accent);
    box-shadow: var(--card-shadow);
    transform: translateY(-2px);
  }

  .skill-card.hidden {
    display: none;
  }

  .skill-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .skill-name {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .skill-level {
    font-size: 0.7rem;
    font-weight: 600;
    color: #fff;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .skill-bar {
    height: 4px;
    background: var(--bg-secondary);
    border-radius: 2px;
    overflow: hidden;
  }

  .skill-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
    transition: width 0.8s ease;
  }
</style>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.skill-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      cards.forEach((card) => {
        const category = card.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>
